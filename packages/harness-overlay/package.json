{
  "name": "@lencx/minke-harness-overlay",
  "description": "HUB-owned DeepSeek Harness product extensions",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.client.json --noEmit && node ../../vendor/deepseek-harness/node_modules/typescript/bin/tsc -b tsconfig.host.json --pretty false"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./web-search": "./lib/web-search.js",
    "./memory": "./lib/memory.js",
    "./voice": "./lib/voice.js",
    "./models": "./lib/models.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./characters": "./lib/characters.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "lib",
    "assets",
    "voice/server.py", "voice/media_inspect.py",
    "voice/supertonic_tts.py", "voice/streaming_asr.py", "voice/native_streaming_stt.py",
    "voice/voice_pipeline.py", "voice/voice_attention.py", "voice/soniox_stt.py", "voice/wake_word.py",
    "voice/playback_guard.py",
    "voice/speech_settings.py",
    "voice/speech_download.py",
    "voice/hub_native_llm.py",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@lencx/minke-model-runtime": "workspace:*",
    "@lencx/minke-remote-access": "workspace:*",
    "@pipecat-ai/client-js": "1.13.1",
    "@pipecat-ai/small-webrtc-transport": "1.10.7",
    "dompurify": "3.4.14",
    "cytoscape": "3.34.2",
    "vega": "6.4.0",
    "vega-interpreter": "2.3.2",
    "qrcode": "1.5.4",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.5",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-tool-subagent": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-goal": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-goal-round-driver": "0.1.2-alpha.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.5",
    "@iconify-json/vscode-icons": "1.2.73",
    "@lucide/icons": "1.31.0",
    "@types/qrcode": "1.5.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "shiki": "4.4.3"
  }
}
